{
  "name": "shannonllc/voicast",
  "description": "PHP SDK for voicast: manage agents, tenants and calls, and verify webhooks and in-call tool requests.",
  "type": "library",
  "license": "MIT",
  "keywords": ["voicast", "voice", "voice-ai", "conversational-ai", "standard-webhooks", "sdk"],
  "homepage": "https://voicast.jp/",
  "authors": [{ "name": "SHANNON LIMITED LIABILITY COMPANY" }],
  "support": {
    "issues": "https://github.com/shannonllc/voicast-php/issues",
    "source": "https://github.com/shannonllc/voicast-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": { "Voicast\\": "src/" },
    "files": ["src/functions.php"]
  },
  "autoload-dev": {
    "psr-4": { "Voicast\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
